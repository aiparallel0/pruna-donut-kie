# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.uv/

# Notebook checkpoints
.ipynb_checkpoints/

# OS junk
.DS_Store
Thumbs.db

# Build artefacts
build/
dist/
*.egg-info/

# Data (sha256-pinned downloads; not committed — use scripts/fetch_sroie.sh)
data/*
!data/.gitkeep

# Checkpoints (not committed — use scripts/fetch_checkpoint.sh)
checkpoints/*
!checkpoints/.gitkeep

# Run results (generated by sweep; not committed)
results/per_config/*
!results/per_config/.gitkeep
results/runs/
results/pareto_frontier.png
results/pareto_frontier.pdf
